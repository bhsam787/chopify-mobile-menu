# Copy to .env.production next to docker-compose.yml on the server and fill
# in. Never commit the copy (.env.* is gitignored).

# Shopify app (Partner Dashboard → Apps → Chopi - Menu → Client credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://chopi.aaxira.co.uk
SCOPES=read_products,read_content,read_legal_policies,read_themes,write_files,read_locales,read_reports

# Production database (a separate Neon database, not the development one)
DATABASE_URL=
DIRECT_URL=

# Help page "Message the developer" and feature requests.
SUPPORT_EMAIL=
SUPPORT_FROM_EMAIL=Chopi - Menu <chopi-support@aaxira.co.uk>
# Sent through your own mail server (mailcow on this VPS)...
SMTP_HOST=mail.aaxira.co.uk
SMTP_PORT=587
SMTP_USER=chopi-support@aaxira.co.uk
SMTP_PASS=
# ...or through Resend instead (leave SMTP_* empty then).
RESEND_API_KEY=

NODE_ENV=production
