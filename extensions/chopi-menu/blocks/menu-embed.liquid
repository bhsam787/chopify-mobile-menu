{%- liquid
  assign menu = app.metafields.chopi.menu.value
  assign entitlement = app.metafields.chopi.entitlement.value
  # Linked resources by ID (written on publish): Shopify resolves current URLs, titles and images.
  assign refs = shop.metafields['$app:chopi']
  assign reference_keys = 'collection_1,collection_2,collection_3,collection_4,product_1,product_2,product_3,product_4,page_1,page_2,page_3,page_4,article_1,article_2,article_3,article_4' | split: ','
  assign product_limit = menu.meta.productLimit | default: 8
  # Only the shopper's language is loaded: "t_pt-BR", else the base "t_pt".
  assign locale_code = request.locale.iso_code
  assign texts_key = 't_' | append: locale_code
  assign texts = app.metafields.chopi[texts_key].value
  if texts == blank
    assign base_code = locale_code | split: '-' | first
    assign texts_key = 't_' | append: base_code
    assign texts = app.metafields.chopi[texts_key].value
  endif
-%}
{%- if menu != blank -%}
  <script type="application/json" id="chopi-menu-data">
    {
      "menu": {{ menu | json }},
      "translations": {{ texts | json }},
      "appUrl": {{ 'chopi-menu-app.js' | asset_url | json }},
      "liveAllowed": {% if entitlement.live_allowed %}true{% else %}false{% endif %},
      "designMode": {{ request.design_mode | json }},
      "triggerOverride": {{ block.settings.trigger_selector | json }},
      "menuButtons": {{ app.metafields.chopi.menu_buttons.value | json }},
      "context": {
        "locale": {{ locale_code | json }},
        "shopName": {{ shop.name | json }},
        "customerLoggedIn": {% if customer %}true{% else %}false{% endif %},
        "currency": {{ cart.currency.iso_code | json }},
        {%- comment -%} The store's most searched terms (refreshed by the app from Shopify's search statistics). {%- endcomment -%}
        "topSearches": {{ app.metafields.chopi.top_searches.value.terms | json }},
        {%- if shop.brand.logo %}
          "logo": { "url": {{ shop.brand.logo | image_url: width: 400 | json }} },
        {%- endif %}
        "routes": {
          "root": {{ routes.root_url | json }},
          "search": {{ routes.search_url | json }},
          "collections": {{ routes.collections_url | json }},
          "all_products": {{ routes.all_products_collection_url | json }},
          "account": {{ routes.account_url | json }},
          "account_login": {{ routes.account_login_url | json }},
          "cart": {{ routes.cart_url | json }}
        },
        {%- if menu.meta.localization %}
          "localization": {
            "action": "/localization",
            "returnTo": {{ request.path | json }},
            "country": {{ localization.country.iso_code | json }},
            "language": {{ localization.language.iso_code | json }},
            "countries": [
              {%- for country in localization.available_countries -%}
                {%- unless forloop.first %},{% endunless -%}
                { "code": {{ country.iso_code | json }}, "name": {{ country.name | append: ' (' | append: country.currency.iso_code | append: ' ' | append: country.currency.symbol | append: ')' | json }} }
              {%- endfor -%}
            ],
            "languages": [
              {%- for language in localization.available_languages -%}
                {%- unless forloop.first %},{% endunless -%}
                { "code": {{ language.iso_code | json }}, "name": {{ language.endonym_name | capitalize | json }} }
              {%- endfor -%}
            ]
          },
        {%- endif %}
        "liveResources": true,
        "resources": {
          {%- capture entries -%}
            {%- for key in reference_keys -%}
              {%- assign kind = key | split: '_' | first -%}
              {%- for object in refs[key].value -%}
                {%- render 'menu-resource', kind: kind, object: object -%}
              {%- endfor -%}
            {%- endfor -%}
            {%- comment -%} Story circles and product cards: a collection's products, read from the referenced collection. Prices are in the shopper's currency; strip_html because a store's money format may contain HTML. {%- endcomment -%}
            {%- for collection in refs.product_collections.value -%}
              {{ 'collection:' | append: collection.id | json }}: {
                "url": {{ collection.url | json }},
                "title": {{ collection.title | json }}
                {%- if collection.featured_image %}, "image": {{ collection.featured_image | image_url: width: 600 | json }}{% endif -%},
                "products": [
                  {%- for product in collection.products limit: product_limit -%}
                    {%- unless forloop.first %},{% endunless -%}
                    {
                      "title": {{ product.title | json }},
                      "url": {{ product.url | json }},
                      "price": {{ product.price | money | strip_html | json }}
                      {%- if product.compare_at_price > product.price %}, "compareAtPrice": {{ product.compare_at_price | money | strip_html | json }}{% endif -%}
                      {%- if product.featured_image %}, "image": {{ product.featured_image | image_url: width: 400 | json }}{% endif -%}
                    }
                  {%- endfor -%}
                ]
              },
            {%- endfor -%}
          {%- endcapture -%}
          {{- entries | strip | remove_last: ',' -}}
        }
      }
    }
  </script>
  <script src="{{ 'chopi-menu.js' | asset_url }}" defer></script>
{%- endif -%}
{%- comment -%} Only in a store window the app opened to point at the menu icon (its window name holds the pick session); shoppers never load the picker. {%- endcomment -%}
<script>
  if (window.name.indexOf('chopi-pick:') === 0) {
    var chopiPicker = document.createElement('script');
    chopiPicker.src = {{ 'chopi-picker.js' | asset_url | json }};
    chopiPicker.defer = true;
    document.head.appendChild(chopiPicker);
  }
</script>

{% schema %}
{
  "name": "t:embed.name",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "trigger_selector",
      "label": "t:embed.trigger_selector.label",
      "info": "t:embed.trigger_selector.info"
    }
  ]
}
{% endschema %}
